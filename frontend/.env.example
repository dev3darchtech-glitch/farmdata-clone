# Backend API Base URL (must be reachable from the device/emulator)
# Android emulator: use 10.0.2.2 instead of localhost
# Physical device: use your machine's LAN IP, e.g. http://[IP_ADDRESS]/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
# Required for Google Sign-In token refresh flow
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here.apps.googleusercontent.com

# Google OAuth token endpoint (usually no need to change)
EXPO_PUBLIC_OAUTH_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
